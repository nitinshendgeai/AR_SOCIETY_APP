# ─────────────────────────────────────────────────────────────────────────────
# AR Society ERP — Environment Variables Template
# Copy this file to .env (never commit .env with real values)
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="AR Society ERP"
APP_VERSION="1.0.0"
APP_ENV=production
DEBUG=false

# Railway internal URL — set this in Railway Variables dashboard, never here
DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@postgres.railway.internal:5432/railway

# For local development use the public proxy URL from Railway dashboard
# DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@<PROXY_HOST>:<PROXY_PORT>/railway

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<REPLACE_WITH_STRONG_RANDOM_SECRET>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

ALLOWED_ORIGINS=["*"]

# Auto-run migrations on Railway deploy
RUN_MIGRATIONS=true

# SMTP (transactional email). Leave SMTP_HOST blank to disable email —
# the app works the same, it just won't send any.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Notified on every new society self-registration (details + default
# user credentials).
ADMIN_NOTIFICATION_EMAIL=admin@duxos.in
